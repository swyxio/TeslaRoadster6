{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bay-drive",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-17",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "MAX_PLAYERS": "64" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true }
}
