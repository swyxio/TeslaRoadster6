{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bay-drive",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-17",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "MAX_PLAYERS": "64" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }, { "name": "CHAT", "class_name": "GlobalChat" }, { "name": "DRIVERS", "class_name": "DriverProfile" }, { "name": "ECONOMIES", "class_name": "RoomEconomy" }, { "name": "INCOME", "class_name": "GlobalIncome" }, { "name": "GLOBAL_EVENTS", "class_name": "GlobalEarningsEvent" }, { "name": "MARKET", "class_name": "MarketService" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }, { "tag": "v2", "new_sqlite_classes": ["GlobalChat"] }, { "tag": "v3", "new_sqlite_classes": ["DriverProfile", "RoomEconomy", "GlobalIncome"] }, { "tag": "v4", "new_sqlite_classes": ["GlobalEarningsEvent"] }, { "tag": "v5", "new_sqlite_classes": ["MarketService"] }],
  "previews": {
    "vars": { "MAX_PLAYERS": "64" },
    "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }, { "name": "CHAT", "class_name": "GlobalChat" }, { "name": "DRIVERS", "class_name": "DriverProfile" }, { "name": "ECONOMIES", "class_name": "RoomEconomy" }, { "name": "INCOME", "class_name": "GlobalIncome" }, { "name": "GLOBAL_EVENTS", "class_name": "GlobalEarningsEvent" }, { "name": "MARKET", "class_name": "MarketService" }] }
  },
  "observability": { "enabled": true }
}
