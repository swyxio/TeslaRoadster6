{
  "freshGuest": true,
  "viewport": {
    "width": 1280,
    "height": 720,
    "deviceScaleFactor": 1
  },
  "steps": [
    {
      "type": "waitFor",
      "selector": "#connection:has-text(\"LIVE\")",
      "timeoutMs": 60000
    },
    {
      "type": "waitForPoseRevision",
      "value": 1,
      "timeoutMs": 30000
    },
    {
      "type": "waitForRoomReady",
      "timeoutMs": 30000
    },
    {
      "type": "beginRoom"
    },
    {
      "type": "waitForTicks",
      "count": 20
    },
    {
      "type": "recordStart"
    },
    {
      "type": "frameStart"
    },
    {
      "type": "keyPress",
      "key": "KeyV"
    },
    {
      "type": "wait",
      "ms": 60000
    },
    {
      "type": "wait",
      "ms": 4000
    },
    {
      "type": "frameStop"
    },
    {
      "type": "sample"
    },
    {
      "type": "recordStop"
    }
  ]
}
