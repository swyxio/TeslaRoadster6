    { "type": "assertNumberAbove", "selector": "#speed", "value": 0 },
    { "type": "touchUp" },
    { "type": "touchDown", "selector": "#jump-control" },
    { "type": "wait", "ms": 800 },
    { "type": "touchUp" },
    { "type": "wait", "ms": 2000 },
    { "type": "screenshot", "name": "after" }
  ]
